---
/**
 * Shell for every page other than the homepage: same header, footer,
 * promo bar and sticky call bar, with a titled page head.
 */
import Base from './Base.astro';
import '../styles/home.css';
import '../styles/variant-b.css';
import SiteNav from '../components/SiteNav.astro';
import PromoBar from '../components/PromoBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCallBar from '../components/StickyCallBar.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  standfirst?: string;
  current?: string;
}

const { title, description, heading, standfirst, current } = Astro.props;

const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400;9..144,600&family=Public+Sans:wght@400;500;600&display=swap';
---

<Base title={title} description={description} fontsHref={fonts} bodyClass="hp vb" withCallbar>
  <PromoBar />
  <SiteNav current={current} />
  <main>
    <section class="hp-section hp-pagehead">
      <h1 class="hp-h2">{heading}</h1>
      {standfirst && <p class="hp-sub hp-italic">{standfirst}</p>}
    </section>
    <slot />
  </main>
  <SiteFooter />
  <StickyCallBar />
</Base>

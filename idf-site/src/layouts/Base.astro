---
import '../styles/global.css';
import { preLaunch } from '../lib/site';

interface Props {
  title: string;
  description: string;
  fontsHref: string;
  bodyClass?: string;
  withCallbar?: boolean;
  /**
   * Keep this page out of search indexes permanently, independently of the
   * site-wide pre-launch block below. Set on pages that must stay unindexed
   * even after launch — so that removing the site-wide tag at launch cannot
   * quietly expose them.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  fontsHref,
  bodyClass = '',
  withCallbar = false,
  noindex = false,
} = Astro.props;

/**
 * Canonical URL. Emitted only when a real origin is configured — see `site`
 * in astro.config.mjs. A canonical pointing at the wrong host is worse than
 * none, so this stays absent until the domain exists.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      preLaunch || noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    {canonical && <link rel="canonical" href={canonical} />}
    {/* The logo's centre gable. The full lockup is 3:1 and turns to mush at
        favicon size, so the tab icon is the mark's central element on the
        brand cream — same artwork, legible at 16px. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body class:list={[bodyClass, { 'with-callbar': withCallbar }]}>
    <slot />
  </body>
</html>

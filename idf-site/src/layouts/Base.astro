---
import '../styles/global.css';
/* Motion and depth below the hero, on every page. Its selectors are anchored
   on body.hp so they hold regardless of where the bundle places it. */
import '../styles/polish.css';
/* The header and its full-screen menu, then the colour rhythm below the
   hero. Same anchoring as polish.css. */
import '../styles/nav.css';
import '../styles/theme.css';
/* The same language carried onto every other page, lightly. */
import '../styles/pages.css';
/* Live motion, mostly for phones: see the map at the top of the file. */
import '../styles/motion.css';
import { preLaunch } from '../lib/site';
import { features } from '../content/idf';
import LeadPopup from '../components/LeadPopup.astro';

interface Props {
  title: string;
  description: string;
  fontsHref: string;
  bodyClass?: string;
  withCallbar?: boolean;
  /**
   * Keep this page out of search indexes permanently, independently of the
   * site-wide pre-launch block below. Set on pages that must stay unindexed
   * even after launch — so that removing the site-wide tag at launch cannot
   * quietly expose them.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  fontsHref,
  bodyClass = '',
  withCallbar = false,
  noindex = false,
} = Astro.props;

/**
 * Canonical URL. Emitted only when a real origin is configured — see `site`
 * in astro.config.mjs. A canonical pointing at the wrong host is worse than
 * none, so this stays absent until the domain exists.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      preLaunch || noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    {canonical && <link rel="canonical" href={canonical} />}
    {/* The logo's centre gable. The full lockup is 3:1 and turns to mush at
        favicon size, so the tab icon is the mark's central element on the
        brand cream — same artwork, legible at 16px. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
    {/* Every scroll entrance is scoped to this class, so nothing on the site
        is hidden unless a script is running to bring it back. Inline and in
        the head because it has to be set before the first paint: added any
        later and each section would paint, vanish and fade in again.

        One line, so it is not worth a network round trip, and `is:inline`
        keeps Astro from bundling it into a deferred module, which would
        defeat the point entirely. */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class:list={[bodyClass, { 'with-callbar': withCallbar }]}>
    {/* Keyboard and screen reader users otherwise tab through the promo bar,
        the logo and every item of a nine-entry menu before reaching the page,
        on every page. Hidden until focused, so it costs sighted visitors
        nothing. Every page's content is inside <main>, which is what this
        targets, and the target takes tabindex="-1" so that browsers actually
        move focus there and not just the scroll position. */}
    <a class="skip-link" href="#main">Skip to content</a>

    <slot />

    {features.promoPopup && <LeadPopup />}

    {/* Scroll entrances for every page. Deferred by Astro, which is correct:
        the finished state is already in the markup and this only adds the
        arrival. */}
    <script>
      import { initReveal } from '../scripts/reveal';
      import { initPolish } from '../scripts/polish';
      /* Polish first: it splits headings into words, and those words have to
         exist before reveal.ts adds the `.in` that sets them moving. */
      initPolish();
      initReveal();
    </script>
  </body>
</html>

---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  fontsHref: string;
  bodyClass?: string;
  withCallbar?: boolean;
}

const { title, description, fontsHref, bodyClass = '', withCallbar = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Design exploration phase — keep out of search indexes until launch -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body class:list={[bodyClass, { 'with-callbar': withCallbar }]}>
    <slot />
  </body>
</html>

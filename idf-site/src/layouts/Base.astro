---
import '../styles/global.css';
import { preLaunch } from '../lib/site';

interface Props {
  title: string;
  description: string;
  fontsHref: string;
  bodyClass?: string;
  withCallbar?: boolean;
  /**
   * Keep this page out of search indexes permanently, independently of the
   * site-wide pre-launch block below. Set on pages that must stay unindexed
   * even after launch — so that removing the site-wide tag at launch cannot
   * quietly expose them.
   */
  noindex?: boolean;
}

const {
  title,
  description,
  fontsHref,
  bodyClass = '',
  withCallbar = false,
  noindex = false,
} = Astro.props;

/**
 * Canonical URL. Emitted only when a real origin is configured — see `site`
 * in astro.config.mjs. A canonical pointing at the wrong host is worse than
 * none, so this stays absent until the domain exists.
 */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      preLaunch || noindex ? (
        <meta name="robots" content="noindex, nofollow" />
      ) : null
    }
    {canonical && <link rel="canonical" href={canonical} />}
    {/* The logo's centre gable. The full lockup is 3:1 and turns to mush at
        favicon size, so the tab icon is the mark's central element on the
        brand cream — same artwork, legible at 16px. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body class:list={[bodyClass, { 'with-callbar': withCallbar }]}>
    <slot />

    {/*
      Width diagnostic, off unless the URL carries ?debug=width.
      Nothing renders and no work is done on a normal visit.

      It exists because a horizontal-scroll bug reported on iPhone could not be
      reproduced in this project's only available engine, Chromium. Rather than
      keep guessing, this reports from the device that actually has the
      problem. Remove it once that is settled.
    */}
    <script is:inline>
      if (location.search.indexOf('debug=width') !== -1) {
        addEventListener('load', function () {
          /* The page clamps itself with overflow-x: hidden on html and body.
             Measuring under that clamp is pointless: scrollWidth is clipped to
             the viewport and every element counts as "inside something that
             clips", so the honest answer is always zero offenders. Lift the
             clamp, measure, put it back. */
          var lift = document.createElement('style');
          lift.textContent = 'html,body{overflow-x:visible!important}';
          document.head.appendChild(lift);
          document.documentElement.getBoundingClientRect();

          var vw = document.documentElement.clientWidth;
          var doc = Math.max(
            document.documentElement.scrollWidth,
            document.body.scrollWidth
          );
          var hits = [];
          var all = document.querySelectorAll('*');
          for (var i = 0; i < all.length; i++) {
            var el = all[i];
            if (el === lift) continue;
            var cs = getComputedStyle(el);
            if (cs.position === 'fixed') continue;
            /* Skip anything a genuine scroller already contains, e.g. the
               review carousel. html and body are excluded from this walk
               because their clamp is exactly what we just lifted. */
            var clipped = false;
            for (var n = el.parentElement; n && n !== document.body; n = n.parentElement) {
              var ox = getComputedStyle(n).overflowX;
              if (ox === 'auto' || ox === 'scroll' || ox === 'hidden' || ox === 'clip') { clipped = true; break; }
            }
            if (clipped) continue;
            var b = el.getBoundingClientRect();
            if (!b.width || !b.height) continue;
            if (b.right > vw + 1 || b.left < -1) {
              hits.push({
                name: el.tagName.toLowerCase() + (el.className && typeof el.className === 'string'
                  ? '.' + el.className.trim().split(/\s+/).join('.') : ''),
                over: Math.round(Math.max(b.right - vw, 0) + Math.max(-b.left, 0)),
              });
            }
          }
          hits.sort(function (a, c) { return c.over - a.over; });

          lift.remove();

          /* Local renders fall back to system fonts because the sandbox cannot
             reach Google Fonts, so text is narrower there than on a real
             phone. Report whether the real faces arrived. */
          var fontNote = 'fonts n/a';
          try {
            fontNote = 'Fraunces ' + (document.fonts.check('1em Fraunces') ? 'yes' : 'NO') +
              ', Public Sans ' + (document.fonts.check('1em "Public Sans"') ? 'yes' : 'NO');
          } catch (e) { /* older engines */ }

          var box = document.createElement('div');
          box.setAttribute('style', 'position:fixed;left:0;right:0;top:0;z-index:99999;' +
            'background:#14110d;color:#f6f1e7;font:12px/1.45 ui-monospace,Menlo,monospace;' +
            'padding:10px 12px;max-height:60vh;overflow:auto;-webkit-overflow-scrolling:touch;');
          var lines = [
            'viewport ' + vw + '  inner ' + window.innerWidth + '  document ' + doc +
              (doc > vw ? '  OVERFLOW +' + (doc - vw) : '  (no overflow)'),
            fontNote,
            'offenders: ' + hits.length,
          ];
          for (var j = 0; j < Math.min(hits.length, 14); j++) {
            lines.push('+' + hits[j].over + 'px  ' + hits[j].name.slice(0, 70));
          }
          box.textContent = lines.join('\n');
          box.style.whiteSpace = 'pre-wrap';
          document.body.appendChild(box);
        });
      }
    </script>
  </body>
</html>

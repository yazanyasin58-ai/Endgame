---
/**
 * Brand lockup.
 *
 * Uses the client's logo file when one is present in /public/img/, otherwise
 * falls back to the text-only wordmark. The fallback is not a placeholder to
 * be tolerated — it is a usable lockup in its own right, which matters
 * because the supplied logo is a raster PNG on a white ground with no vector
 * source. Until a vector arrives the text lockup is the safer mark.
 */
import { optionalImage } from '../lib/images';
import { business } from '../content/idf';

/**
 * The supplied logo is a stacked lockup: house mark above three lines of type.
 * In a horizontal header bar it can only be about 50px tall, and at that size
 * its two tagline lines are unreadable — the mark shrinks to fit the smallest
 * element rather than the most important one.
 *
 * So the header pairs the real house mark with the name set in the site's own
 * face. Same brand, legible at header size. The complete stacked lockup stays
 * available as `logo` for anywhere with the room to show it properly.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const markSrc = optionalImage('img/logo-mark');
---

<a class:list={['logo', className]} href="/">
  {markSrc && <img class="logo-mark" src={markSrc} alt="" />}
  <span class="logo-text">
    <span class="logo-name">{business.name}</span>
    <span class="logo-lockup">{business.lockup} &middot; Est. {business.established}</span>
  </span>
</a>

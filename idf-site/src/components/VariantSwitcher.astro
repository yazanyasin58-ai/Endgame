---
/**
 * Review chrome only — lets the three variants be flipped between on one
 * screen. Removed before launch, like the version switcher before it.
 */
const variants = [
  { id: 'a', path: '/', label: 'A' },
  { id: 'b', path: '/b/', label: 'B' },
  { id: 'c', path: '/c/', label: 'C' },
];
interface Props { current: string }
const { current } = Astro.props;
---

<nav class="vswitch" aria-label="Variant switcher">
  {
    variants.map((v) => (
      <a href={v.path} class:list={[{ active: v.id === current }]} aria-current={v.id === current ? 'page' : undefined}>
        {v.label}
      </a>
    ))
  }
</nav>

---
/**
 * Reviews carousel.
 *
 * A horizontal scroll-snap track: swipe on touch, drag or wheel on trackpad,
 * arrow buttons and arrow keys everywhere else. The scrolling itself is CSS,
 * so the reviews are readable and swipeable before the script runs and if it
 * never runs at all — the buttons are added by script and hidden until then,
 * rather than sitting there dead.
 *
 * Long reviews collapse to a fixed number of lines with a Read more control.
 * That control is also script-added: without JavaScript the full text shows
 * uncollapsed, which is the right failure — a truncated review with no way to
 * open it would misrepresent what someone wrote.
 */
import type { Review } from '../content/idf';
import { writeReviewUrl } from '../content/idf';

interface Props {
  reviews: readonly Review[];
  heading?: string;
  headingId?: string;
  standfirst?: string;
  /**
   * Upgrade to live Google reviews on load. Pass `features.googleReviews`.
   * When false, none of the fetch or render code is in the build.
   */
  live?: boolean;
}

const {
  reviews,
  heading = 'What clients say',
  headingId = 'rc-heading',
  standfirst,
  live = false,
} = Astro.props;
---

<section class="hp-section rc-wrap" aria-labelledby={headingId} data-rc-live={live ? '' : null}>
  <div class="rc-head">
    <div>
      <h2 id={headingId} class="hp-h2">{heading}</h2>
      {/*
        The true average and the true review count, filled in only when the
        live fetch succeeds — which is the same moment the cards become a
        four-star-and-up selection. Filter and aggregate arrive together by
        construction, so the page cannot show a rating-filtered set of reviews
        without also showing the numbers for all of them and a link to read
        them. See the note on MIN_RATING in functions/api/reviews.ts.
      */}
      {live && (
        <p class="rc-agg" data-rc-agg hidden>
          <span class="rc-agg-score" data-rc-agg-score />
          <span class="rc-agg-note" data-rc-agg-note />
        </p>
      )}
      {/* Hidden with the controls: with few enough reviews to fit on screen
          there is nothing to swipe, and telling someone to swipe a static row
          is worse than saying nothing. */}
      {standfirst && <p class="hp-sub hp-italic" data-rc-hint hidden>{standfirst}</p>}
    </div>
    {/* Hidden until the script enables them — see the note above. */}
    <div class="rc-controls" data-rc-controls hidden>
      <button class="rc-arrow" type="button" data-rc-prev aria-label="Previous reviews">
        <svg viewBox="0 0 12 20" aria-hidden="true">
          <path d="M10 1 2 10l8 9" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
      <button class="rc-arrow" type="button" data-rc-next aria-label="More reviews">
        <svg viewBox="0 0 12 20" aria-hidden="true">
          <path d="M2 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>
  </div>

  <div class="rc-track" data-rc-track tabindex="0" role="group" aria-label="Customer reviews, scrollable">
    {
      reviews.map((r) => (
        <blockquote class="rc-card">
          {r.rating && (
            <p class="rc-stars">
              <span class="rc-stars-mark" aria-hidden="true">
                {'★'.repeat(r.rating)}
                {'☆'.repeat(5 - r.rating)}
              </span>
              <span class="rc-sr">{r.rating} out of 5 stars</span>
            </p>
          )}
          <div class="rc-quote-box" data-rc-quote>
            <p class="rc-quote hp-italic">{r.quote}</p>
          </div>
          <footer class="rc-foot">
            <cite class="rc-name">{r.name}</cite>
            <span class="rc-context">
              {r.context}
              {r.source && <span class="rc-source">{r.source} review</span>}
            </span>
          </footer>
        </blockquote>
      ))
    }
  </div>

  <p class="rc-cta">
    <a class="rc-cta-link" href={writeReviewUrl} rel="nofollow noopener" target="_blank">
      Leave us a Google review
    </a>
  </p>

  {
    /*
      One copy of the card markup, cloned by the script. A second hand-written
      copy in JavaScript would drift from the one above the first time either
      is touched.
    */
    live && (
      <template data-rc-template>
        <blockquote class="rc-card">
          <p class="rc-stars">
            <span class="rc-stars-mark" aria-hidden="true" data-f="stars" />
            <span class="rc-sr" data-f="sr" />
          </p>
          <div class="rc-quote-box" data-rc-quote>
            <p class="rc-quote hp-italic" data-f="quote" />
          </div>
          <footer class="rc-foot">
            <cite class="rc-name" data-f="name" />
            <span class="rc-context">
              <span data-f="when" />
              <a class="rc-source rc-source-link" data-f="link" rel="nofollow noopener" target="_blank">
                Review on Google
              </a>
            </span>
          </footer>
        </blockquote>
      </template>
    )
  }
</section>

<script>
  /**
   * One script for every carousel on the page.
   *
   * Paging scrolls by the visible width rather than by a card count, so it
   * behaves the same whether one card or three are on screen. Buttons disable
   * at the ends instead of wrapping — a carousel that silently jumps back to
   * the start loses people.
   */
  import { applyLiveFigures } from '../scripts/live-figures';

  interface LiveReview {
    name: string;
    rating: number;
    quote: string;
    when: string;
    photo?: string;
    uri?: string;
  }

  document.querySelectorAll<HTMLElement>('.rc-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-rc-track]');
    const controls = wrap.querySelector<HTMLElement>('[data-rc-controls]');
    const prev = wrap.querySelector<HTMLButtonElement>('[data-rc-prev]');
    const next = wrap.querySelector<HTMLButtonElement>('[data-rc-next]');
    if (!track) return;

    /* ---- Read more, per card ---- */
    const setupReadMore = (box: HTMLElement) => {
      const quote = box.querySelector<HTMLElement>('.rc-quote');
      if (!quote || box.dataset.rcClamped) return;
      box.dataset.rcClamped = 'done';

      /*
       * Decide from the text's own height against the clamp limit, not
       * against the box's height. The box is a flex child that grows to fill
       * the card, and card height is set by the tallest card in the row — so
       * measuring the box meant a long review sitting beside another long one
       * reported "it fits", dropped its Read more, and ran the whole row tall.
       */
      const maxLines = 6;
      const lineHeight = parseFloat(getComputedStyle(quote).lineHeight);
      if (!lineHeight || quote.scrollHeight <= lineHeight * maxLines + 2) return;

      box.classList.add('is-clamped');

      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'rc-more';
      toggle.textContent = 'Read more';
      toggle.setAttribute('aria-expanded', 'false');
      box.after(toggle);

      toggle.addEventListener('click', () => {
        const open = box.classList.toggle('is-clamped') === false;
        toggle.textContent = open ? 'Read less' : 'Read more';
        toggle.setAttribute('aria-expanded', String(open));
      });
    };

    const scanCards = () =>
      wrap.querySelectorAll<HTMLElement>('[data-rc-quote]').forEach(setupReadMore);

    scanCards();

    /* ---- Paging ---- */
    /* Set by the marquee once it is looping. While it is, the track has no
       ends to arrive at, so disabling the arrows there would be a lie. */
    const loop = { on: false };

    const sync = () => {
      if (loop.on) {
        if (prev) prev.disabled = false;
        if (next) next.disabled = false;
        return;
      }
      const max = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max - 2;
    };

    const page = (direction: 1 | -1) => {
      track.scrollBy({ left: direction * track.clientWidth * 0.9, behavior: 'smooth' });
    };

    let paged = false;
    const setupPaging = () => {
      // Re-checked rather than done once: replacing the cards with the live
      // set changes how much there is to scroll, in either direction.
      const scrollable = track.scrollWidth - track.clientWidth > 4;
      if (!scrollable) {
        controls?.setAttribute('hidden', '');
        wrap.querySelector('[data-rc-hint]')?.setAttribute('hidden', '');
        return;
      }
      controls?.removeAttribute('hidden');
      wrap.querySelector('[data-rc-hint]')?.removeAttribute('hidden');
      if (paged) {
        sync();
        return;
      }
      paged = true;

      prev?.addEventListener('click', () => page(-1));
      next?.addEventListener('click', () => page(1));

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          page(1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          page(-1);
        }
      });

      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    };

    setupPaging();

    /* ---- Continuous drift ---- */
    /**
     * The reviews move on their own, and the visitor can still swipe, drag,
     * click or use the arrows at any moment. The client asked for both.
     *
     * It animates scrollLeft, not a transform. That is the whole design: a
     * CSS transform marquee and a scroll container are two separate positions
     * for the same strip, so a visitor who swipes one is fighting the other.
     * Driving the scroller means auto-movement and a finger are the same
     * action, and handing control over is just stopping.
     *
     * Seamlessness needs a second copy of the cards. The copies are
     * aria-hidden and have every link and button swapped for plain spans, so
     * a screen reader reads each review once and nothing focusable hides
     * inside a hidden subtree. The visible original is always one scroll away.
     *
     * Snapping is turned off while this is on. Mandatory snap and a
     * per-frame scrollLeft fight each other and the result stutters. A free
     * scroller is still perfectly swipeable; losing snap is the price of
     * continuous motion and it is the right way round.
     */
    const SPEED = 40;          // px per second, close to the reference site
    const RESUME_AFTER = 2500; // ms of stillness before it picks back up

    const motionOk = matchMedia('(prefers-reduced-motion: no-preference)');

    const marquee = (() => {
      let frame = 0;
      let last = 0;
      let period = 0;
      let idle: ReturnType<typeof setTimeout> | undefined;
      let held = false;        // visitor is touching, hovering or focused
      let running = false;

      const clearClones = () => {
        track.querySelectorAll('[data-rc-clone]').forEach((n) => n.remove());
      };

      /* The position is kept as a float here and written to the element each
         frame, rather than read back and incremented. At 40px/s a frame is
         two thirds of a pixel, and an engine that reports scrollLeft rounded
         would swallow every step and the strip would never move. `applied`
         is how a frame tells the difference between its own last write and a
         visitor having moved the track underneath it. */
      let pos = 0;
      let applied = 0;

      const tick = (now: number) => {
        if (!running) return;
        const dt = last ? Math.min(now - last, 100) : 0;
        last = now;
        if (Math.abs(track.scrollLeft - applied) > 1) pos = track.scrollLeft;
        if (!held && !document.hidden && period > 0 && dt) {
          pos += (SPEED * dt) / 1000;
          if (pos >= period) pos -= period;
          track.scrollLeft = pos;
          applied = track.scrollLeft;
        }
        frame = requestAnimationFrame(tick);
      };

      const stop = () => {
        running = false;
        if (frame) cancelAnimationFrame(frame);
        frame = 0;
        last = 0;
        loop.on = false;
        track.classList.remove('is-marquee');
        clearClones();
        sync();
      };

      const hold = () => {
        held = true;
        if (idle) clearTimeout(idle);
      };
      const release = () => {
        if (idle) clearTimeout(idle);
        idle = setTimeout(() => {
          held = false;
          last = 0;             // do not bank the paused time into one jump
        }, RESUME_AFTER);
      };

      let bound = false;
      const bind = () => {
        if (bound) return;
        bound = true;
        // Hover and focus hold it open-endedly; the rest are moments, so they
        // hold and then start the idle countdown.
        track.addEventListener('pointerenter', hold);
        track.addEventListener('pointerleave', release);
        track.addEventListener('focusin', hold);
        track.addEventListener('focusout', release);
        for (const type of ['pointerdown', 'touchstart', 'wheel', 'keydown'] as const) {
          track.addEventListener(type, () => { hold(); release(); }, { passive: true });
        }
        // The arrows live outside the track, so they need their own hold.
        controls?.addEventListener('pointerdown', () => { hold(); release(); });
        controls?.addEventListener('click', () => { hold(); release(); });
        document.addEventListener('visibilitychange', () => { last = 0; });
      };

      const start = () => {
        stop();
        if (!motionOk.matches) return;

        const cards = [...track.children] as HTMLElement[];
        if (cards.length < 2) return;
        // Nothing to drift through if the whole set is already on screen.
        if (track.scrollWidth - track.clientWidth < 4) return;

        for (const card of cards) {
          const copy = card.cloneNode(true) as HTMLElement;
          copy.setAttribute('data-rc-clone', '');
          copy.setAttribute('aria-hidden', 'true');
          /* No focusable node may sit inside an aria-hidden subtree, and a
             cloned control would be dead anyway: cloneNode does not bring
             listeners with it. Both problems go away by making them text. */
          copy.querySelectorAll('a, button').forEach((el) => {
            const span = document.createElement('span');
            span.className = el.className;
            span.textContent = el.textContent;
            el.replaceWith(span);
          });
          track.appendChild(copy);
        }

        /* Measured from the layout rather than computed from widths and gaps,
           so it stays right whatever the breakpoint does to either. */
        const firstClone = track.querySelector<HTMLElement>('[data-rc-clone]');
        if (!firstClone) return;
        period = firstClone.offsetLeft - cards[0].offsetLeft;
        if (period <= 0) { clearClones(); return; }

        track.classList.add('is-marquee');
        loop.on = true;
        pos = track.scrollLeft;
        applied = pos;
        bind();
        sync();
        running = true;
        frame = requestAnimationFrame(tick);
      };

      return { start, stop };
    })();

    marquee.start();
    // A resize changes card widths, which changes the loop length.
    let resized: ReturnType<typeof setTimeout> | undefined;
    window.addEventListener('resize', () => {
      if (resized) clearTimeout(resized);
      resized = setTimeout(() => marquee.start(), 250);
    });
    motionOk.addEventListener('change', () => marquee.start());

    /* ---- Live Google reviews ---- */
    const template = wrap.querySelector<HTMLTemplateElement>('[data-rc-template]');
    if (!wrap.hasAttribute('data-rc-live') || !template) return;

    const field = (root: ParentNode, name: string) =>
      root.querySelector<HTMLElement>(`[data-f="${name}"]`);

    const render = (data: {
      rating: number | null;
      total: number | null;
      href: string | null;
      minRating: number;
      reviews: LiveReview[];
    }) => {
      /*
       * Two or fewer live reviews is not a carousel, and it is a thinner
       * showing than the curated set it would replace. Keep what is already
       * on the page — the fallback is the better outcome, not a failure.
       */
      if (data.reviews.length < 3) return;

      const agg = wrap.querySelector<HTMLElement>('[data-rc-agg]');
      const score = wrap.querySelector<HTMLElement>('[data-rc-agg-score]');
      const note = wrap.querySelector<HTMLElement>('[data-rc-agg-note]');

      /*
       * The invariant, enforced before anything is swapped in rather than
       * hoped for afterward: these cards are filtered to four stars and up,
       * so they may only go on the page together with the true average and
       * the true total. If either number is missing — Google omitted it, or
       * renamed the field — the honest outcome is to keep the unfiltered
       * curated set, not to show a filtered one with nothing qualifying it.
       *
       * Found by testing this exact case: without the guard the cards
       * appeared and the aggregate silently stayed hidden.
       */
      if (!agg || !score || !note || data.rating === null || data.total === null) return;

      const cards = document.createDocumentFragment();
      for (const r of data.reviews) {
        const node = template.content.cloneNode(true) as DocumentFragment;
        const stars = field(node, 'stars');
        if (stars) stars.textContent = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
        const sr = field(node, 'sr');
        if (sr) sr.textContent = `${r.rating} out of 5 stars`;
        // textContent throughout: review text is written by the public and is
        // never inserted as markup.
        const quote = field(node, 'quote');
        if (quote) quote.textContent = r.quote;
        const name = field(node, 'name');
        if (name) name.textContent = r.name;
        const when = field(node, 'when');
        if (when) when.textContent = r.when;
        const link = field(node, 'link') as HTMLAnchorElement | null;
        if (link) {
          const href = r.uri || data.href;
          if (href) link.href = href;
          else link.replaceWith(document.createTextNode('Google review'));
        }
        cards.appendChild(node);
      }

      /* Stop first. The clones are about to be discarded with everything
         else, and a running loop would keep driving a stale period. */
      marquee.stop();
      track.replaceChildren(cards);
      track.scrollLeft = 0;

      // Guarded above, so this always runs when the cards are replaced.
      score.textContent = `${data.rating.toFixed(1)} ★`;
      note.textContent =
        `average from ${data.total} Google review${data.total === 1 ? '' : 's'}` +
        ` — a selection of ${data.minRating}-star and above.`;
      if (data.href) {
        const link = document.createElement('a');
        link.className = 'rc-agg-link';
        link.href = data.href;
        link.rel = 'nofollow noopener';
        link.target = '_blank';
        link.textContent = 'See all reviews on Google';
        agg.after(link);
      }
      agg.removeAttribute('hidden');

      /*
       * The stats row further up the page carries the same numbers. Update
       * them from this one response so the page cannot show two different
       * Google ratings — the committed figure and the carousel's average are
       * read at different times. Shared with the About page, which prints the
       * same numbers without a carousel.
       */
      applyLiveFigures(data);

      scanCards();
      setupPaging();
      // Re-measured against the live cards, which are a different width and
      // a different number from the curated set.
      marquee.start();
    };

    fetch('/api/reviews', { headers: { accept: 'application/json' } })
      .then((res) => (res.ok ? res.json() : null))
      .then((data) => {
        if (data && data.ok && Array.isArray(data.reviews)) render(data);
      })
      .catch(() => {
        /* Curated reviews are already on the page. Nothing to report. */
      });
  });
</script>

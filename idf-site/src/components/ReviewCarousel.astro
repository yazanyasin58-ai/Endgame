---
/**
 * Reviews carousel.
 *
 * A horizontal scroll-snap track: swipe on touch, drag or wheel on trackpad,
 * arrow buttons and arrow keys everywhere else. The scrolling itself is CSS,
 * so the reviews are readable and swipeable before the script runs and if it
 * never runs at all — the buttons are added by script and hidden until then,
 * rather than sitting there dead.
 *
 * Long reviews collapse to a fixed number of lines with a Read more control.
 * That control is also script-added: without JavaScript the full text shows
 * uncollapsed, which is the right failure — a truncated review with no way to
 * open it would misrepresent what someone wrote.
 */
import type { Review } from '../content/idf';

interface Props {
  reviews: readonly Review[];
  heading?: string;
  headingId?: string;
  standfirst?: string;
}

const {
  reviews,
  heading = 'What clients say',
  headingId = 'rc-heading',
  standfirst,
} = Astro.props;
---

<section class="hp-section rc-wrap" aria-labelledby={headingId}>
  <div class="rc-head">
    <div>
      <h2 id={headingId} class="hp-h2">{heading}</h2>
      {/* Hidden with the controls: with few enough reviews to fit on screen
          there is nothing to swipe, and telling someone to swipe a static row
          is worse than saying nothing. */}
      {standfirst && <p class="hp-sub hp-italic" data-rc-hint hidden>{standfirst}</p>}
    </div>
    {/* Hidden until the script enables them — see the note above. */}
    <div class="rc-controls" data-rc-controls hidden>
      <button class="rc-arrow" type="button" data-rc-prev aria-label="Previous reviews">
        <svg viewBox="0 0 12 20" aria-hidden="true">
          <path d="M10 1 2 10l8 9" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
      <button class="rc-arrow" type="button" data-rc-next aria-label="More reviews">
        <svg viewBox="0 0 12 20" aria-hidden="true">
          <path d="M2 1l8 9-8 9" fill="none" stroke="currentColor" stroke-width="2" />
        </svg>
      </button>
    </div>
  </div>

  <div class="rc-track" data-rc-track tabindex="0" role="group" aria-label="Customer reviews, scrollable">
    {
      reviews.map((r) => (
        <blockquote class="rc-card">
          {r.rating && (
            <p class="rc-stars">
              <span class="rc-stars-mark" aria-hidden="true">
                {'★'.repeat(r.rating)}
                {'☆'.repeat(5 - r.rating)}
              </span>
              <span class="rc-sr">{r.rating} out of 5 stars</span>
            </p>
          )}
          <div class="rc-quote-box" data-rc-quote>
            <p class="rc-quote hp-italic">{r.quote}</p>
          </div>
          <footer class="rc-foot">
            <cite class="rc-name">{r.name}</cite>
            <span class="rc-context">
              {r.context}
              {r.source && <span class="rc-source">{r.source} review</span>}
            </span>
          </footer>
        </blockquote>
      ))
    }
  </div>
</section>

<script>
  /**
   * One script for every carousel on the page.
   *
   * Paging scrolls by the visible width rather than by a card count, so it
   * behaves the same whether one card or three are on screen. Buttons disable
   * at the ends instead of wrapping — a carousel that silently jumps back to
   * the start loses people.
   */
  document.querySelectorAll<HTMLElement>('.rc-wrap').forEach((wrap) => {
    const track = wrap.querySelector<HTMLElement>('[data-rc-track]');
    const controls = wrap.querySelector<HTMLElement>('[data-rc-controls]');
    const prev = wrap.querySelector<HTMLButtonElement>('[data-rc-prev]');
    const next = wrap.querySelector<HTMLButtonElement>('[data-rc-next]');
    if (!track) return;

    /* ---- Read more, per card ---- */
    wrap.querySelectorAll<HTMLElement>('[data-rc-quote]').forEach((box) => {
      const quote = box.querySelector<HTMLElement>('.rc-quote');
      if (!quote) return;

      /*
       * Decide from the text's own height against the clamp limit, not
       * against the box's height. The box is a flex child that grows to fill
       * the card, and card height is set by the tallest card in the row — so
       * measuring the box meant a long review sitting beside another long one
       * reported "it fits", dropped its Read more, and ran the whole row tall.
       */
      const maxLines = 6;
      const lineHeight = parseFloat(getComputedStyle(quote).lineHeight);
      if (!lineHeight || quote.scrollHeight <= lineHeight * maxLines + 2) return;

      box.classList.add('is-clamped');

      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'rc-more';
      toggle.textContent = 'Read more';
      toggle.setAttribute('aria-expanded', 'false');
      box.after(toggle);

      toggle.addEventListener('click', () => {
        const open = box.classList.toggle('is-clamped') === false;
        toggle.textContent = open ? 'Read less' : 'Read more';
        toggle.setAttribute('aria-expanded', String(open));
      });
    });

    /* ---- Paging ---- */
    const scrollable = () => track.scrollWidth - track.clientWidth > 4;
    if (!scrollable()) return;

    controls?.removeAttribute('hidden');
    wrap.querySelector('[data-rc-hint]')?.removeAttribute('hidden');

    const page = (direction: 1 | -1) => {
      track.scrollBy({ left: direction * track.clientWidth * 0.9, behavior: 'smooth' });
    };

    prev?.addEventListener('click', () => page(-1));
    next?.addEventListener('click', () => page(1));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        page(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        page(-1);
      }
    });

    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max - 2;
    };
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

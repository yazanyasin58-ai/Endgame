---
/**
 * Site header.
 *
 * The full menu shows on wide screens; below that it collapses into a single
 * disclosure. Built on <details>/<summary> so everything opens, closes and
 * takes keyboard focus without JavaScript — the script only adds dismissal on
 * Escape or an outside click, and closes a sibling group when one opens.
 *
 * Nine flat links became five entries, two of them groups. Grouping is why the
 * desktop row now fits: see the breakpoint note in home.css.
 *
 * Gated entries are omitted entirely rather than rendered disabled: a nav item
 * pointing at content we are not cleared to publish is itself a liability.
 */
import Logo from './Logo.astro';
import { business, nav, features } from '../content/idf';

interface Props {
  current?: string;
}

const { current } = Astro.props;

/**
 * A gated entry appears only when its gate is exactly `true`. The real estate
 * gate also has a 'preview' state, which is truthy but must NOT put the link
 * in the nav: preview means the owner can read the page at its URL, not that
 * the site advertises it.
 */
const open = (entry: { gated?: string }) =>
  !('gated' in entry) || features[entry.gated as keyof typeof features] === true;

interface NavLink {
  label: string;
  href: string;
}
interface NavEntry extends NavLink {
  children?: NavLink[];
}

/* Filter both levels, then drop the dropdown from any group whose children
   have all been gated away — a group with nothing under it is a plain link. */
const items: NavEntry[] = nav.filter(open).map((entry) => {
  const children = 'children' in entry ? entry.children.filter(open) : [];
  return children.length > 0
    ? { label: entry.label, href: entry.href, children: children.map((c) => ({ label: c.label, href: c.href })) }
    : { label: entry.label, href: entry.href };
});

const isCurrent = (entry: NavEntry) =>
  current === entry.href || (entry.children ?? []).some((c) => c.href === current);
---

<header class="hp-nav">
  <Logo class="hp-logo" />

  <nav class="hp-nav-links" aria-label="Main">
    {
      items.map((i) =>
        i.children ? (
          <details class="hp-nav-group" data-nav-group>
            <summary aria-current={isCurrent(i) ? 'true' : undefined}>
              {i.label}
              <svg viewBox="0 0 10 6" aria-hidden="true">
                <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
              </svg>
            </summary>
            <div class="hp-nav-panel">
              {i.children.map((c) => (
                <a href={c.href} aria-current={current === c.href ? 'page' : undefined}>
                  {c.label}
                </a>
              ))}
            </div>
          </details>
        ) : (
          <a href={i.href} aria-current={current === i.href ? 'page' : undefined}>
            {i.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="hp-nav-actions">
    <a class="hp-nav-phone" href={business.phonePrimaryHref}>{business.phonePrimary}</a>
    <a class="hp-btn hp-btn--sm" href="/estimate/">Free Estimate</a>

    <details class="hp-menu" data-nav-group>
      <summary aria-label="Menu">
        <span class="hp-menu-label">Menu</span>
        <svg viewBox="0 0 16 12" aria-hidden="true">
          <path d="M0 1h16M0 6h16M0 11h16" fill="none" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </summary>
      {/* Flattened rather than nested: a disclosure inside a disclosure is a
          poor thing to operate on a phone. Groups become labelled blocks. */}
      <div class="hp-menu-panel">
        {
          items.map((i) =>
            i.children ? (
              <div class="hp-menu-block">
                <p class="hp-menu-block-label">{i.label}</p>
                {i.children.map((c) => (
                  <a href={c.href} aria-current={current === c.href ? 'page' : undefined}>
                    {c.label}
                  </a>
                ))}
              </div>
            ) : (
              <a href={i.href} aria-current={current === i.href ? 'page' : undefined}>
                {i.label}
              </a>
            ),
          )
        }
        <hr />
        <a href="/estimate/"><strong>Request an Estimate</strong></a>
        <a href="/list-your-home/"><strong>Tell us about your property</strong></a>
      </div>
    </details>
  </div>
</header>

<script>
  /**
   * One handler for every disclosure in the header: the mobile Menu and each
   * desktop group. Opening one closes the others, so two panels can never
   * overlap.
   */
  const groups = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('[data-nav-group]'),
  );

  const closeOthers = (keep: HTMLDetailsElement) => {
    for (const other of groups) if (other !== keep) other.open = false;
  };

  for (const group of groups) {
    group.addEventListener('toggle', () => {
      if (group.open) closeOthers(group);
    });
  }

  /**
   * Hover to open, on pointing devices only.
   *
   * Click still opens and closes everything, so this is an enhancement rather
   * than the mechanism — with no JavaScript the menu behaves exactly as it did
   * before. `(hover: hover) and (pointer: fine)` keeps it off touch screens,
   * where a hover menu opens on the tap that was meant to follow the link.
   *
   * The close is delayed. Without it, the diagonal a pointer travels from the
   * label toward an item lower in the list leaves the group for a few frames
   * and the menu shuts under the cursor. 180ms is enough to cross that and
   * short enough not to feel stuck open.
   */
  const pointer = window.matchMedia('(hover: hover) and (pointer: fine)');
  const desktop = window.matchMedia('(min-width: 1100px)');
  let closeTimer: number | undefined;

  const hoverable = groups.filter((g) => g.classList.contains('hp-nav-group'));
  for (const group of hoverable) {
    group.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse' || !pointer.matches || !desktop.matches) return;
      window.clearTimeout(closeTimer);
      group.open = true;
      closeOthers(group);
    });

    group.addEventListener('pointerleave', (event) => {
      if (event.pointerType !== 'mouse' || !pointer.matches || !desktop.matches) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        group.open = false;
      }, 180);
    });

    /*
     * Once hover opens the menu, a mouse click on the label would toggle it
     * shut — the panel vanishes under a cursor that was on its way into it,
     * which reads as the menu being broken. Suppress that one case.
     *
     * `event.detail > 0` is what separates a real click from Enter or Space on
     * the summary, which browsers also deliver as a click but with detail 0.
     * Without that check this would lock keyboard users out of the menu
     * entirely on any machine with a mouse attached.
     */
    group.addEventListener('click', (event) => {
      if (!pointer.matches || !desktop.matches) return;
      if (event.detail === 0) return;
      const summary = group.querySelector('summary');
      if (summary && summary.contains(event.target as Node) && group.open) {
        event.preventDefault();
      }
    });
  }

  document.addEventListener('click', (event) => {
    for (const group of groups) {
      if (group.open && !group.contains(event.target as Node)) group.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const group of groups) {
      if (group.open) {
        group.open = false;
        group.querySelector('summary')?.focus();
      }
    }
  });

  /**
   * The sticky header's one piece of behaviour: get out of the film's way.
   *
   * The header is sticky in CSS from 768px up. On pages with the scrubbed
   * hero that would pin a paper-coloured bar across the top of a full-screen
   * film for its whole seven screens, so while the film owns the viewport
   * the bar tucks up out of sight and comes back when the film is done.
   *
   * Pages without a hero (every page but the homepage) have no .sh to watch,
   * so they take the plain sticky behaviour and this whole block exits.
   *
   * THE RULE THIS HAS TO OBEY, and the bug that taught it:
   *
   * A sticky element keeps its space in normal flow. Tuck it before it is
   * actually stuck and that space is still on screen, so the translate
   * leaves a bar-shaped hole of bare page background where the header was.
   *
   * An earlier version guessed at "the film owns the viewport" by watching
   * the hero against a band 10% of the viewport tall. The promo bar ships
   * hidden and is revealed by script, and stays hidden for good once
   * dismissed, which lifts the hero from y=131 to y=76; under a 90px band
   * the hero then counted as visible at scroll 0, the header tucked on load,
   * and every returning visitor opened the site to a white gap where the
   * navigation should be.
   *
   * A second version replaced the band with sentinel elements pinned inside
   * the hero, which fixed the gap and introduced a quieter fault:
   * IntersectionObserver reports CHANGES in intersection, and a jump from
   * mid-hero to past the hero leaves a 1px sentinel non-intersecting on both
   * sides of the jump, so no callback fires and the state goes stale. Normal
   * wheel scrolling drags the sentinel through the viewport and hides this
   * completely. Pressing End, or following an in-page anchor, does not, and
   * the header stays tucked away for the rest of the page.
   *
   * So the condition is evaluated directly, because it is two comparisons:
   *
   *   r.top <= 0              the hero's top is above the viewport, which is
   *                           also exactly "the header is stuck", since the
   *                           header sits immediately above the hero. The
   *                           hole is therefore impossible by construction.
   *   r.bottom > innerHeight  the sticky stage is still sticking, ie the film
   *                           has not played out yet.
   *
   * True at every scroll position, however it was reached, with no state to
   * go stale and nothing to recompute on resize. The listener is passive and
   * coalesced into one rAF, so a burst of scroll events costs a single rect
   * read per frame, and it is only attached on the one page that has a hero.
   *
   * Reduced motion keeps the bar visible throughout rather than animating it
   * in and out. The header is then simply sticky, which is the accessible
   * behaviour anyway, and the CSS drops the transition to match.
   */
  const header = document.querySelector('.hp-nav');
  const hero = document.querySelector('.sh');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');
  const sticky = window.matchMedia('(min-width: 768px)');

  if (header && hero) {
    let queued = false;

    const update = () => {
      queued = false;
      const r = hero.getBoundingClientRect();
      header.classList.toggle('is-tucked', r.top <= 0 && r.bottom > window.innerHeight);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };

    let armed = false;
    const arm = () => {
      if (armed) return;
      armed = true;
      addEventListener('scroll', onScroll, { passive: true });
      addEventListener('resize', onScroll, { passive: true });
      update();
    };

    const disarm = () => {
      if (!armed) return;
      armed = false;
      removeEventListener('scroll', onScroll);
      removeEventListener('resize', onScroll);
      header.classList.remove('is-tucked');
    };

    const apply = () => (sticky.matches && motionOk.matches ? arm() : disarm());

    motionOk.addEventListener('change', apply);
    sticky.addEventListener('change', apply);
    apply();
  }
</script>

---
/**
 * The one interactive moment.
 *
 * The premise of the whole page is that every finish starts as a frame, and
 * that the part a customer never sees is the part that decides whether the
 * finish lasts. Here the visitor performs it: press and hold, and the house
 * travels from open timber framing to the finished property.
 *
 * The two photographs are THE TWO ENDS OF THE HERO FILM, its first frame and
 * its last: the same house as a skeleton on a building site, and finished at
 * golden hour. So this is the hero's own journey compressed into one gesture,
 * and it costs nothing extra because the film already contains both.
 *
 * Note what this deliberately is NOT. It is not a locked-off before and after
 * of one view, and it does not pretend to be: the two frames are taken from
 * different points in a moving camera move, so they are different vantages on
 * one house rather than one vantage at two times. That was a considered
 * choice. A true locked-off pair was attempted three times and measured each
 * time: a generated still drifted 24.5px of roofline against its reference
 * with horizontal structure correlating at only 0.256, and a generated
 * locked-camera time-lapse drifted steadily to 25.1px with correlation
 * falling to 0.258. These models will not hold an exact camera position
 * across a large content change, and a crossfade between near-but-not-quite
 * aligned frames reads as a glitch, which is worse than an honest dissolve.
 *
 * If real before-and-after photography of one IDF project ever arrives, that
 * is strictly better than either and should replace this.
 *
 * The mechanics that stop it feeling like a gimmick:
 *   - progress builds while held
 *   - releasing early eases back down, it never snaps to zero
 *   - completing it lights the three points in sequence, so the action earns
 *     something rather than just moving a slider
 *   - reduced motion gets the finished state immediately, no holding required
 */
---

<section class="ftf hp-section" aria-labelledby="ftf-h">
  <div class="ftf-head">
    <p class="ftf-kicker">Hold to build</p>
    <h2 class="hp-h2" id="ftf-h">Every finish starts as a frame</h2>
    <p class="hp-sub hp-italic">
      The part you never see is the part that decides how long the part you do see lasts.
    </p>
  </div>

  <div class="ftf-stage" data-ftf>
    <div class="ftf-frames">
      <img class="ftf-img ftf-img--raw" src="/hero/state-frame.jpg" alt="A large house at the timber framing stage, seen from the air: open stud walls, bare roof trusses and a graded building site around it" width="1600" height="900" loading="lazy" decoding="async" />
      <img class="ftf-img ftf-img--done" src="/hero/state-finish.jpg" alt="The same house finished at golden hour: stone and stucco facade, lit windows, planted grounds and the fountains running" width="1600" height="900" loading="lazy" decoding="async" />
      <div class="ftf-veil" aria-hidden="true"></div>
    </div>

    <button class="ftf-hold" type="button" data-ftf-hold
            aria-describedby="ftf-h">
      <span class="ftf-hold-ring" aria-hidden="true">
        <svg viewBox="0 0 56 56" aria-hidden="true">
          <circle class="ftf-ring-bg" cx="28" cy="28" r="24" />
          <circle class="ftf-ring-fg" cx="28" cy="28" r="24" transform="rotate(-90 28 28)" />
        </svg>
      </span>
      <span class="ftf-hold-label" data-ftf-label>Press and hold</span>
    </button>
  </div>

  <ol class="ftf-points" data-ftf-points>
    <li><strong>Framing and structure.</strong> Square, level, and carrying the loads it should.</li>
    <li><strong>What goes behind the wall.</strong> Wiring, pipework and insulation, before anything closes.</li>
    <li><strong>The finish you actually see.</strong> Floors, trim and paint, on top of work that was done right.</li>
  </ol>
</section>

<script>
  (() => {
    const stage = document.querySelector('[data-ftf]');
    if (!stage) return;
    const holdBtn = stage.querySelector('[data-ftf-hold]');
    const label = stage.querySelector('[data-ftf-label]');
    const section = stage.closest('.ftf');
    const points = section.querySelector('[data-ftf-points]');

    const reduce = matchMedia('(prefers-reduced-motion: reduce)');

    let p = 0;              // 0 raw, 1 finished
    let holding = false;
    let raf = null;
    let last = 0;
    let done = false;

    function paint() {
      section.style.setProperty('--p', p.toFixed(3));
    }

    function complete() {
      if (done) return;
      done = true;
      section.classList.add('is-done');
      label.textContent = 'Built';
      holdBtn.setAttribute('aria-pressed', 'true');
    }

    function tick(now) {
      const dt = Math.min(64, now - (last || now));
      last = now;
      // 1.4s to fill while held, 0.9s to ease back when released
      // Once the room is built it STAYS built. Letting it decay after
      // completion takes back the thing the visitor just earned, and leaves
      // the lit points describing a room that has gone back to studs.
      const rate = done ? 0 : (holding ? dt / 1400 : -dt / 900);
      p = done ? 1 : Math.min(1, Math.max(0, p + rate));
      paint();
      if (p >= 1) complete();
      if (done) { raf = null; last = 0; return; }
      if ((holding && p < 1) || (!holding && p > 0)) {
        raf = requestAnimationFrame(tick);
      } else {
        raf = null; last = 0;
      }
    }

    function start(e) {
      if (e && e.cancelable) e.preventDefault();
      if (done) return;
      if (reduce.matches) { p = 1; paint(); complete(); return; }
      holding = true;
      if (raf === null) { last = 0; raf = requestAnimationFrame(tick); }
    }
    function stop() {
      holding = false;
      if (raf === null && p > 0) { last = 0; raf = requestAnimationFrame(tick); }
    }

    holdBtn.addEventListener('pointerdown', start);
    addEventListener('pointerup', stop);
    addEventListener('pointercancel', stop);
    holdBtn.addEventListener('keydown', (e) => {
      if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); start(); }
    });
    holdBtn.addEventListener('keyup', (e) => {
      if (e.key === ' ' || e.key === 'Enter') stop();
    });
    holdBtn.addEventListener('blur', stop);

    // Reduced motion, honored live and in both directions.
    function applyReduce() {
      if (reduce.matches) { holding = false; p = 1; paint(); complete(); }
    }
    reduce.addEventListener('change', applyReduce);
    applyReduce();
    paint();
  })();
</script>

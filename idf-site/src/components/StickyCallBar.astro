---
import { business } from '../content/idf';
---

<div class="callbar" aria-label="Call or text us">
  <a class="callbar-call" href={business.phonePrimaryHref}>
    {/* A handset that rings now and then, with a sonar ring behind it, so
        the one control on a phone that reaches the owner is the one the eye
        finds. After "Ripple Buttons" (sonar). Decoration only. */}
    <span class="callbar-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"
           stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2" />
      </svg>
    </span>
    Call {business.phonePrimary}
  </a>
  <a class="callbar-text" href={business.phonePrimarySms}>Text us</a>
</div>

---
/**
 * Promotional bar for the first-project offer.
 *
 * Deliberately a dismissible bar rather than an entry overlay: Google demotes
 * intrusive interstitials on mobile, which is most of this client's traffic.
 * It states the offer and directs to a conversation — the terms (cap,
 * eligible work, expiry) have not been defined, so none are implied here.
 */
import { promo } from '../content/idf';
---

<div class="promo" id="promo" hidden>
  <p class="promo-text">
    <strong>{promo.headline}</strong>
    <span>{promo.detail}</span>
  </p>
  <a class="promo-cta" href="/estimate/">
    <span class="promo-cta-full">{promo.cta}</span>
    <span class="promo-cta-short">{promo.ctaShort}</span>
  </a>
  <button class="promo-close" type="button" aria-label="Dismiss offer">&times;</button>
</div>

<script>
  // Tiny inline script — the only client JS on the page. Shows the bar unless
  // the visitor has dismissed it before.
  const bar = document.getElementById('promo');
  if (bar) {
    const KEY = 'idf-promo-dismissed';
    if (localStorage.getItem(KEY) !== '1') bar.hidden = false;
    bar.querySelector('.promo-close')?.addEventListener('click', () => {
      bar.hidden = true;
      localStorage.setItem(KEY, '1');
    });
  }
</script>

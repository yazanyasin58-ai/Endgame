---
import { versions } from '../content/idf';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav class="vswitch" aria-label="Design direction switcher">
  <a href="/" aria-label="Back to direction index">&#8962;</a>
  {
    versions.map((v) => (
      <a
        href={v.path}
        class:list={[{ active: v.id === current }]}
        aria-current={v.id === current ? 'page' : undefined}
      >
        {v.id.toUpperCase()}
      </a>
    ))
  }
</nav>

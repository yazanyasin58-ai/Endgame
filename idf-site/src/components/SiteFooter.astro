---
import { business, hours, hoursLabel, serviceArea, writeReviewUrl, googleSnapshot, propertyPaths } from '../content/idf';
import SocialLinks from './SocialLinks.astro';
import Logo from './Logo.astro';
---

<footer class="foot">
  <div class="foot-inner">
    {/* Logo, then the social icons, then the Google review button — the
        presentation the client asked for, in that reading order. */}
    <div class="foot-brand">
      <Logo class="foot-logo" />
      <div class="foot-marks">
        <SocialLinks class="foot-social foot-social--brand" />
        <a class="foot-review" href={writeReviewUrl} target="_blank" rel="noopener noreferrer">
          <span class="foot-review-g" aria-hidden="true">G</span>
          <span class="foot-review-text">
            Review us on Google
            <span class="foot-review-sub">{googleSnapshot.rating} from {googleSnapshot.total} reviews</span>
          </span>
        </a>
      </div>
    </div>

    <div class="foot-cols">
      <div class="foot-col">
        <h2 class="foot-head">Showroom</h2>
        <p>45431 Ruritan Circle, Suite 160<br />Sterling, VA 20164</p>
        <h2 class="foot-head foot-head--spaced">Hours</h2>
        <ul class="foot-hours">
          {
            hours.map((h) => (
              <li>
                <span>{h.days}</span>
                <span>{hoursLabel(h)}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="foot-col">
        <h2 class="foot-head">Contact</h2>
        <p>
          <a href={business.phonePrimaryHref}>{business.phonePrimary}</a><br />
          <a href={business.phoneSecondaryHref}>{business.phoneSecondary}</a><br />
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </p>
      </div>
      <div class="foot-col">
        <h2 class="foot-head">License</h2>
        <p>{business.license}<br />Licensed &amp; Insured · Residential</p>
        <h2 class="foot-head foot-head--spaced">Start here</h2>
        <p>
          <a href="/estimate/">Request a free estimate</a><br />
          {propertyPaths.map((path) => (
            <>
              <a href={`/list-your-home/?for=${path.key}#listing-form`}>{path.title}</a><br />
            </>
          ))}
        </p>
      </div>
    </div>

    <div class="foot-area">
      <h2 class="foot-head">Service area</h2>
      <p>{serviceArea.detail}</p>
      <ul class="foot-regions">
        {serviceArea.regions.map((r) => <li>{r}</li>)}
      </ul>
    </div>

    <div class="foot-legal">
      <p class="foot-fine">
        &copy; 2026 {business.name} · {business.lockup} · Sterling, Virginia
      </p>
      <ul class="foot-legal-links">
        <li><a href="/privacy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms &amp; Conditions</a></li>
        <li><a href="/sitemap/">Sitemap</a></li>
      </ul>
    </div>
  </div>

  {/* Oversized wordmark behind the columns, after the 21st.dev "Modem
      Animated Footer". Decoration only: hidden from assistive tech, and the
      footer clips it so it can never widen the page. */}
  <p class="pl-foot-mark rv" aria-hidden="true">{business.name}</p>
</footer>

---
/**
 * Projects Completed.
 *
 * Only two projects are named by the owner — Great Falls and Maryland. The
 * rest of the grid is reserved, labelled space rather than invented work:
 * no fabricated project names, locations, budgets, square footage or dates.
 */
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import SiteNav from '../components/SiteNav.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Placeholder from '../components/Placeholder.astro';
import { business, projects, trustBar, cta } from '../content/idf';
import { optionalImage, heroImages } from '../lib/images';

const fonts =
  'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Sans+3:wght@400;600&display=swap';

// Named work first, then reserved slots for the list the owner is compiling.
const named = projects.filter((p) => p.named);
const reservedSlots = 4;
---

<Base
  title="Projects Completed — Interior Design Flooring"
  description="Completed custom homes, additions and remodeling projects by Interior Design Flooring, a Virginia Class A general contractor serving Northern Virginia since 1989."
  fontsHref={fonts}
  bodyClass="hp"
  withCallbar
>
  <SiteNav current="projects" />

  <main>
    <section class="hp-section hp-pagehead">
      <h1 class="hp-h2">Projects completed</h1>
      <p class="hp-sub hp-italic">
        Custom homes, additions and remodels across Northern Virginia.
      </p>
    </section>

    <section class="hp-section hp-section--tight" aria-label="Completed projects">
      <div class="hp-grid">
        {
          named.map((proj) => (
            <figure class="hp-project">
              <Placeholder ratio="4 / 3" label="Placeholder — project · 4:3 · 1200px" class="hp-ph" />
              <figcaption>
                <span class="hp-project-name">{proj.name}</span>
              </figcaption>
            </figure>
          ))
        }

        <figure class="hp-project">
          <Placeholder
            ratio="4 / 3"
            label="Comp — work in progress · 4:3"
            src={optionalImage(heroImages.work)}
            alt="A home addition under construction, new framing against the existing house"
            class="hp-ph"
          />
          <figcaption>
            <span class="hp-project-name">Addition in progress</span>
          </figcaption>
        </figure>

        {
          Array.from({ length: reservedSlots }, (_, i) => (
            <figure class="hp-project hp-project--reserved">
              <Placeholder ratio="4 / 3" label="Reserved — awaiting project photography" class="hp-ph" />
              <figcaption>
                <span class="hp-muted">Project {i + 4} — details to be confirmed</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

      <p class="hp-note">
        More projects are being added as photography is collected. Nothing on this page is
        listed until the owner has confirmed it.
      </p>
    </section>

    <section class="hp-trust" aria-label="Credentials">
      <ul>
        {trustBar.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="hp-final" aria-labelledby="pr-cta-h">
      <div class="hp-final-inner hp-final-inner--single">
        <div>
          <h2 id="pr-cta-h" class="hp-final-heading">Want something like this?</h2>
          <p class="hp-final-sub hp-italic">
            A site visit first, then a written estimate within 24 hours.
          </p>
          <div class="hp-hero-actions">
            <a class="hp-btn" href="/estimate/">{cta.primary}</a>
            <a class="hp-call hp-call--light" href={business.phonePrimaryHref}>
              or call {business.phonePrimary}
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <StickyCallBar />
</Base>

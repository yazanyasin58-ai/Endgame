---
/**
 * One page per service, from `servicePages`.
 *
 * Twelve services share this layout exactly, so they share one file. Adding or
 * editing a service is a content change in src/content/services-detail.ts —
 * the same rule the gallery slots follow, and the reason no two service pages
 * can drift apart in structure.
 */
import Page from '../../layouts/Page.astro';
import FaqList from '../../components/FaqList.astro';
import { servicePages } from '../../content/services-detail';
import { serviceFaq } from '../../content/service-faq';
import { business, cta } from '../../content/idf';
import { serviceImages, serviceImageSet } from '../../content/service-images';

export function getStaticPaths() {
  return servicePages.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;

const others = servicePages.filter((s) => s.slug !== service.slug);

/* AI illustrations, one family across all twelve pages. Each is marked as an
   illustration where it appears; see the note in service-images.ts. */
const alt = serviceImages[service.slug];
const img = serviceImageSet(service.slug);
const NOTE = 'Illustration';

/* Guaranteed present: service-faq.ts fails the build if any service page
   has no questions, so this is never an empty section. */
const questions = serviceFaq[service.slug];

/**
 * FAQPage markup, one set per service page.
 *
 * Twelve pages each carrying their own is fine, and is not the thing the
 * homepage was kept clear of: these are twelve DIFFERENT sets of questions
 * on twelve different URLs, and no question may appear on two of them, which
 * the build enforces. Repeating one set across pages is what makes the
 * markup worthless, not having it on more than one page.
 *
 * Worth being honest about the payoff: Google narrowed FAQ rich results to
 * authoritative government and health sites, so this is unlikely to draw a
 * dropdown in search. It is still valid, still describes the page correctly,
 * and it is exactly the machine-readable Q and A the client's brief asks for
 * under AI and generative-engine visibility.
 */
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a.join(' ') },
  })),
};
---

<Page
  title={`${service.title} — ${business.name}`}
  description={service.standfirst}
  heading={service.title}
  standfirst={service.standfirst}
  current="services"
  crumbs={[{ label: 'Services', href: '/services/' }]}
  image={{ ...img.hero, alt: alt.hero, note: NOTE }}
>
  {/* The introduction beside a close detail of the work. */}
  <section class="hp-section svc-open">
    <div class="svc-intro">
      <div class="svc-prose">
        {service.intro.map((p) => <p>{p}</p>)}
      </div>
      <figure class="svc-fig svc-fig--tall">
        <img
          src={img.detail.src}
          srcset={img.detail.srcset}
          sizes="(min-width: 900px) 24rem, 100vw"
          alt={alt.detail}
          width="1000"
          height="1250"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="svc-fig-note">{NOTE}</figcaption>
      </figure>
    </div>
  </section>

  {/* What the crew does, on midnight, beside a wider scene. */}
  <section class="hp-section hp-section--tight svc-band" aria-labelledby="svc-scope-h">
    <div class="svc-split">
      <figure class="svc-fig svc-fig--scene">
        <img
          src={img.scene.src}
          srcset={img.scene.srcset}
          sizes="(min-width: 900px) 50vw, 100vw"
          alt={alt.scene}
          width="1400"
          height="933"
          loading="lazy"
          decoding="async"
        />
        <figcaption class="svc-fig-note">{NOTE}</figcaption>
      </figure>
      <div class="svc-scope">
        <h2 class="svc-scope-title" id="svc-scope-h">{service.scopeTitle}</h2>
        <ul class="svc-list">
          {service.scope.map((item) => <li>{item}</li>)}
        </ul>
        {service.notes && <p class="svc-note">{service.notes}</p>}
      </div>
    </div>
  </section>

  <section class="hp-section hp-section--tight">
    {/* Questions before the call to action: answer the hesitation, then
        ask. The other way round, the FAQ reads as an afterthought under a
        button nobody pressed yet. */}
    <div class="svc-faq">
      <h2 class="svc-scope-title" id="svc-faq-h">Common questions</h2>
      <FaqList items={questions} name={`svc-faq-${service.slug}`} />
    </div>

    <div class="svc-cta">
      <a class="hp-btn" href="/estimate/">{cta.primary}</a>
      <a class="hp-call" href={business.phonePrimaryHref}>or call {business.phonePrimary}</a>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />

  {/* The other services as picture cards, so the next page is one look away. */}
  <section class="hp-section hp-section--tight svc-more" aria-labelledby="svc-more-h">
    <h2 class="hp-h2" id="svc-more-h">Other services</h2>
    <ul class="svc-cards">
      {others.map((s) => (
        <li>
          <a class="svc-card" href={`/services/${s.slug}/`}>
            <span class="svc-card-media">
              <img
                src={serviceImageSet(s.slug).card}
                alt=""
                width="640"
                height="427"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="svc-card-label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <a class="hp-textlink" href="/services/">All services</a>
  </section>
</Page>

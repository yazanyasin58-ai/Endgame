---
/**
 * V4 — Warm Cream Editorial
 * Warm, calm, generous. Cream ground, serif display in the quiet upper field
 * of the photograph, a single gold action. Instrument Serif / Source Sans 3.
 */
import Base from '../layouts/Base.astro';
import Placeholder from '../components/Placeholder.astro';
import VersionSwitcher from '../components/VersionSwitcher.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import EstimateForm from '../components/EstimateForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
import {
  business,
  trustBar,
  pillars,
  wedge,
  projects,
  homepageReviews,
  processSteps,
  cta,
} from '../content/idf';
import { optionalImage, heroImages } from '../lib/images';

const fonts =
  'https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Sans+3:wght@400;600&display=swap';

const heroSrc = optionalImage(heroImages.v4);
---

<Base
  title="Interior Design Flooring — V4 Warm Cream Editorial"
  description="Homepage direction V4: warm cream editorial. Custom homes, additions, and remodeling in Northern Virginia — Class A contractor, owner-run since 1989."
  fontsHref={fonts}
  bodyClass="v4"
  withCallbar
>
  <VersionSwitcher current="v4" />

  <header class="v4-nav">
    <p class="v4-nav-brand">
      <span class="v4-nav-name">{business.name}</span>
      <span class="v4-nav-lockup">{business.lockup} · est. {business.established}</span>
    </p>
    <a class="v4-nav-phone" href={business.phonePrimaryHref}>{business.phonePrimary}</a>
  </header>

  <main>
    <!-- 1 · HERO — headline sits in the quiet upper field of the image -->
    <section class="v4-hero" aria-label="Introduction">
      <div class="v4-hero-frame">
        <Placeholder
          ratio="16 / 9"
          label="Comp — hero · interior, quiet upper wall · 16:9 · 2400px"
          scene="interior"
          src={heroSrc}
          alt="A finished living space with daylight falling across a quiet wall"
          class="v4-ph v4-hero-ph ph--label-tl"
        />

        <div class="v4-hero-headline">
          <h1 class="v4-h1">A home built the way you asked for it.</h1>
          <p class="v4-hero-italic">
            Custom homes, additions &amp; remodeling in Northern Virginia
          </p>
        </div>

        <div class="v4-hero-action">
          <p class="v4-hero-support">
            Class A contractor, owner-run since 1989.<br />
            Estimate within 24 hours of the site visit.
          </p>
          <a class="v4-pill" href="#estimate">{cta.primary}</a>
          <a class="v4-call" href={business.phonePrimaryHref}>or call {business.phonePrimary}</a>
        </div>
      </div>
    </section>

    <!-- 2 · TRUST BAR -->
    <section class="v4-trust" aria-label="Credentials">
      <ul>
        {trustBar.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <!-- 3 · THREE PILLARS -->
    <section class="v4-section" aria-labelledby="v4-pillars-h">
      <h2 id="v4-pillars-h" class="v4-h2">What we build</h2>
      <p class="v4-section-sub v4-italic">Three ways to start, one team throughout.</p>
      <div class="v4-pillars">
        {
          pillars.map((p) => (
            <article class="v4-pillar">
              <h3 class="v4-pillar-title">{p.title.charAt(0) + p.title.slice(1).toLowerCase()}</h3>
              <ul class="v4-pillar-list">
                {p.services.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- 4 · THE WEDGE -->
    <section class="v4-section v4-wedge" aria-labelledby="v4-wedge-h">
      <p class="v4-wedge-tagline v4-italic">&ldquo;{wedge.tagline}&rdquo;</p>
      <div class="v4-wedge-copy">
        <h2 id="v4-wedge-h" class="v4-wedge-heading">{wedge.heading}</h2>
        {wedge.body.map((para) => <p>{para}</p>)}
      </div>
    </section>

    <!-- 5 · FEATURED PROJECTS -->
    <section class="v4-section" aria-labelledby="v4-projects-h">
      <h2 id="v4-projects-h" class="v4-h2">Recent work</h2>
      <p class="v4-section-sub v4-italic">Real projects, photographed as they were finished.</p>
      <div class="v4-projects">
        {
          projects.map((proj) => (
            <figure class="v4-project">
              <Placeholder ratio="4 / 3" label="Placeholder — project card · 4:3 · 1200px" class="v4-ph" />
              <figcaption>
                {proj.named ? proj.name : <span class="v4-muted">Third project — list in progress</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <!-- 6 · REVIEWS -->
    <section class="v4-section v4-reviews-wrap" aria-labelledby="v4-reviews-h">
      <h2 id="v4-reviews-h" class="v4-h2">Kind words</h2>
      <div class="v4-reviews">
        {
          homepageReviews.map((r) => (
            <blockquote class="v4-review">
              <span class="v4-review-mark" aria-hidden="true">&ldquo;</span>
              <p class="v4-review-quote v4-italic">{r.quote}</p>
              <footer>
                <cite>{r.name}</cite>
                <span class="v4-review-context">{r.context}</span>
              </footer>
            </blockquote>
          ))
        }
      </div>
    </section>

    <!-- 7 · HOW IT WORKS -->
    <section class="v4-section" aria-labelledby="v4-process-h">
      <h2 id="v4-process-h" class="v4-h2">How it works</h2>
      <p class="v4-section-sub v4-italic">Five steps, one of them unusually fast.</p>
      <ol class="v4-steps">
        {
          processSteps.map((step) => (
            <li class:list={['v4-step', { 'v4-step--featured': 'featured' in step && step.featured }]}>
              <span class="v4-step-num">{step.number}</span>
              <div>
                <h3 class="v4-step-title">{step.title}</h3>
                <p class="v4-step-detail">{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- 8 · FINAL CTA — the only charcoal section -->
    <section class="v4-final" id="estimate" aria-labelledby="v4-final-h">
      <div class="v4-final-inner">
        <div class="v4-final-intro">
          <h2 id="v4-final-h" class="v4-final-heading">Let's price your project.</h2>
          <p class="v4-final-sub v4-italic">
            A site visit first, then a written estimate within 24 hours.
          </p>
          <a class="v4-call v4-call--light" href={business.phonePrimaryHref}>
            Prefer to talk? {business.phonePrimary}
          </a>
        </div>
        <EstimateForm idPrefix="v4" />
      </div>
    </section>
  </main>

  <SiteFooter />
  <StickyCallBar />
</Base>

<style is:global>
  .v4 {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1rem;
    line-height: 1.7;
    --v4-rule: rgb(200 162 74 / 0.4);
    --ph-bg: #e7dcc4;
    --ph-fg: #857b62;
  }
  .v4 ::selection {
    background: var(--gold);
    color: var(--ink);
  }
  .v4-italic {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
  }

  /* nav */
  .v4-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 1.4rem clamp(1.25rem, 4vw, 3.5rem);
  }
  .v4-nav-name {
    display: block;
    font-family: 'Instrument Serif', serif;
    font-size: 1.25rem;
    letter-spacing: 0.01em;
  }
  .v4-nav-lockup {
    display: block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gray);
    margin-top: 0.15rem;
  }
  .v4-nav-phone {
    font-size: 0.875rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--v4-rule);
    padding-bottom: 2px;
    white-space: nowrap;
  }
  .v4-nav-phone:hover {
    border-bottom-color: var(--gold);
  }

  /* hero — headline sits in the quiet upper field of the photograph, no scrim */
  .v4-hero {
    padding: 0 clamp(0.75rem, 2.5vw, 2rem);
  }
  .v4-hero-frame {
    position: relative;
  }
  .v4-hero-ph {
    /* soft, light interior wall — the headline sits directly on it */
    --ph-bg: #ece5d6;
    --ph-lo: #d8cfbc;
    --ph-hi: #f7f2e79c;
    --ph-fg: #8a806c;
    --ph-horizon: 68%;
    min-height: 78vh;
  }
  @media (min-width: 1024px) {
    .v4-hero-ph {
      min-height: 0;
      max-height: 88vh;
    }
  }
  .v4-hero-headline {
    position: absolute;
    top: clamp(2.5rem, 9vw, 6.5rem);
    left: clamp(1.25rem, 4vw, 4rem);
    right: clamp(1.25rem, 4vw, 4rem);
    text-align: center;
  }
  .v4-h1 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2.6rem, 6.8vw, 5.75rem);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .v4-hero-italic {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-size: clamp(1.05rem, 2.1vw, 1.65rem);
    color: var(--charcoal);
    margin-top: 0.75rem;
  }
  .v4-hero-action {
    position: absolute;
    right: clamp(1.25rem, 4vw, 4rem);
    bottom: clamp(1.5rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.85rem;
    text-align: right;
  }
  .v4-hero-support {
    font-size: 0.8125rem;
    color: var(--charcoal);
    line-height: 1.65;
  }
  .v4-pill {
    display: inline-block;
    background: var(--gold);
    color: var(--ink);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    padding: 0.95em 2.3em;
    border-radius: 999px;
  }
  .v4-pill:hover {
    background: var(--gold-bright);
  }
  .v4-call {
    font-size: 0.8438rem;
    color: var(--charcoal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* trust bar */
  .v4-trust {
    margin-top: clamp(2rem, 5vw, 3.5rem);
    border-block: 1px solid var(--v4-rule);
    padding: 1.1rem clamp(1.25rem, 4vw, 3.5rem);
  }
  .v4-trust ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 0;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gray);
  }
  .v4-trust li:not(:last-child)::after {
    content: '\00B7';
    color: var(--gold);
    margin-inline: 1.4rem;
  }

  /* sections */
  .v4-section {
    padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.25rem, 4vw, 3.5rem);
  }
  .v4-h2 {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.05;
    text-align: center;
  }
  .v4-section-sub {
    text-align: center;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--gray);
    margin-top: 0.7rem;
  }

  /* pillars */
  .v4-pillars {
    margin-top: 3rem;
    display: grid;
    gap: 2.5rem;
    max-width: 62rem;
    margin-inline: auto;
  }
  @media (min-width: 768px) {
    .v4-pillars {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }
  .v4-pillar {
    text-align: center;
    border-top: 1px solid var(--v4-rule);
    padding-top: 1.75rem;
  }
  .v4-pillar-title {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: 1.75rem;
  }
  .v4-pillar-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    font-size: 0.9063rem;
    color: var(--gray);
  }
  .v4-pillar-list li + li {
    margin-top: 0.35rem;
  }

  /* wedge */
  .v4-wedge {
    background: var(--cream);
    text-align: center;
  }
  .v4-wedge-tagline {
    font-size: clamp(1.6rem, 4.2vw, 3rem);
    line-height: 1.25;
    max-width: 26ch;
    margin-inline: auto;
    color: var(--charcoal);
  }
  .v4-wedge-copy {
    max-width: 38rem;
    margin: 2.5rem auto 0;
  }
  .v4-wedge-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gray);
    margin-bottom: 1.1rem;
  }
  .v4-wedge-copy p {
    font-size: 0.9688rem;
    color: var(--charcoal);
  }
  .v4-wedge-copy p + p {
    margin-top: 0.9rem;
  }

  /* projects */
  .v4-projects {
    margin-top: 3rem;
    display: grid;
    gap: 2.25rem;
  }
  @media (min-width: 768px) {
    .v4-projects {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
    }
  }
  .v4-project {
    margin: 0;
  }
  .v4-project figcaption {
    margin-top: 0.9rem;
    font-family: 'Instrument Serif', serif;
    font-size: 1.2rem;
    text-align: center;
  }
  .v4-muted {
    color: var(--gray);
    font-style: italic;
  }

  /* reviews */
  .v4-reviews-wrap {
    background: var(--cream);
  }
  .v4-reviews {
    margin-top: 3rem;
    display: grid;
    gap: 3.5rem;
    max-width: 60rem;
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .v4-reviews {
      grid-template-columns: 1.25fr 1fr;
      gap: 4rem;
    }
  }
  .v4-review {
    margin: 0;
    position: relative;
    padding-top: 1.5rem;
  }
  .v4-review-mark {
    position: absolute;
    top: -0.75rem;
    left: -0.4rem;
    font-family: 'Instrument Serif', serif;
    font-size: 4.5rem;
    line-height: 1;
    color: var(--gold);
  }
  .v4-review-quote {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.55;
    color: var(--charcoal);
  }
  .v4-review footer {
    margin-top: 1.25rem;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
  }
  .v4-review cite {
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .v4-review-context {
    font-size: 0.75rem;
    color: var(--gray);
  }

  /* steps */
  .v4-steps {
    list-style: none;
    margin: 3rem auto 0;
    padding: 0;
    max-width: 40rem;
  }
  .v4-step {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    gap: 1.25rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--v4-rule);
  }
  .v4-step-num {
    font-family: 'Instrument Serif', serif;
    font-size: 1.5rem;
    color: var(--gray);
  }
  .v4-step-title {
    font-size: 1rem;
    font-weight: 600;
  }
  .v4-step-detail {
    font-size: 0.9063rem;
    color: var(--gray);
    margin-top: 0.25rem;
  }
  .v4-step--featured .v4-step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--gold);
    color: var(--ink);
    font-size: 1.15rem;
  }
  .v4-step--featured .v4-step-title::after {
    content: ' — our promise';
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: var(--gray);
  }

  /* final — the one charcoal moment */
  .v4-final {
    background: var(--charcoal);
    color: var(--cream);
    padding: clamp(3.5rem, 8vw, 6.5rem) clamp(1.25rem, 4vw, 3.5rem);
  }
  .v4-final-inner {
    display: grid;
    gap: 3rem;
    max-width: 66rem;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .v4-final-inner {
      grid-template-columns: 1fr 1.3fr;
      gap: 5rem;
    }
  }
  .v4-final-heading {
    font-family: 'Instrument Serif', serif;
    font-weight: 400;
    font-size: clamp(2.2rem, 5vw, 3.75rem);
    line-height: 1.05;
  }
  .v4-final-sub {
    font-size: 1.15rem;
    color: var(--gold-bright);
    margin-top: 1rem;
  }
  .v4-call--light {
    display: inline-block;
    margin-top: 1.5rem;
    color: var(--cream);
  }

  /* form on charcoal */
  .v4 .ef-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone);
  }
  .v4 .ef-input {
    background: rgb(251 248 242 / 0.06);
    border: 1px solid rgb(251 248 242 / 0.25);
    border-radius: 0.4rem;
    color: var(--cream);
    font-family: inherit;
    font-size: 0.9375rem;
    padding: 0.65rem 0.8rem;
  }
  .v4 .ef-input:focus {
    outline: none;
    border-color: var(--gold-bright);
  }
  .v4 .ef-select option {
    color: var(--ink);
    background: var(--cream);
  }
  .v4 .ef-submit {
    margin-top: 1.75rem;
    background: var(--gold);
    color: var(--ink);
    border: 0;
    border-radius: 999px;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    padding: 0.95em 2.4em;
    cursor: pointer;
  }
  .v4 .ef-submit:hover {
    background: var(--gold-bright);
  }
  .v4 .ef-note {
    margin-top: 1rem;
    color: var(--stone);
  }
  .v4 .ef-optional {
    text-transform: none;
    letter-spacing: 0.02em;
  }

  /* footer — stays charcoal, continuous with final CTA */
  .v4 .foot {
    background: var(--charcoal);
    color: var(--stone);
    border-top: 1px solid rgb(251 248 242 / 0.14);
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 3.5rem) 2rem;
  }
  .v4 .foot-wordmark {
    font-family: 'Instrument Serif', serif;
    font-size: 1.5rem;
    color: var(--cream);
  }
  .v4 .foot-lockup {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-bright);
    margin-top: 0.35rem;
  }
  .v4 .foot-cols {
    margin-top: 2.25rem;
    display: grid;
    gap: 1.75rem;
    font-size: 0.875rem;
  }
  @media (min-width: 768px) {
    .v4 .foot-cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .v4 .foot-head {
    font-size: 0.6563rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--cream);
    margin-bottom: 0.6rem;
  }
  .v4 .foot a {
    color: inherit;
    text-decoration: none;
  }
  .v4 .foot a:hover {
    color: var(--gold-bright);
  }
  .v4 .foot-blocked {
    margin-top: 2.25rem;
    display: grid;
    gap: 0.6rem;
    max-width: 40rem;
    --blocked-bg: var(--charcoal);
  }
  .v4 .foot-fine {
    margin-top: 2.25rem;
    font-size: 0.75rem;
  }
</style>

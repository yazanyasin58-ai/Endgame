---
import { pageImages } from '../content/service-images';
import Page from '../layouts/Page.astro';
import Placeholder from '../components/Placeholder.astro';
import { business, serviceGroups, insuranceRestoration, gallery, cta } from '../content/idf';
import { optionalImage } from '../lib/images';
import { servicePages } from '../content/services-detail';
import { serviceImageSet } from '../content/service-images';

/* The groups below are the owner's own list, so their wording stays. Where an
   item has a detail page of its own it links there; the rest stay plain text
   rather than pointing somewhere approximate. Every one of the twelve pages is
   also reachable from the cards further down, so none depends on this map.
   Added after the second-opinion audit (21 Oct) found the hub linked to
   nothing but the estimate form. */
const itemPage: Record<string, string> = {
  Kitchens: 'kitchen-remodeling',
  Bathrooms: 'bathroom-remodeling',
  Basements: 'basement-remodeling',
  Additions: 'home-additions',
  'Full home renovations': 'home-remodeling',
  Flooring: 'flooring',
  'Interior finishes': 'painting-drywall',
  'Siding, gutters, fascia, and trim': 'roofing-siding',
  'Insurance restoration': 'insurance-claim-repairs',
  'Mold remediation': 'water-damage-mold',
  'Water and structural repair': 'water-damage-mold',
};
const slugs = new Set(servicePages.map((p) => p.slug));
const itemHref = (item: string) =>
  itemPage[item] && slugs.has(itemPage[item]) ? `/services/${itemPage[item]}/` : undefined;

// Exterior work underway — the closest of the photographs to what a storm or
// water loss actually looks like being repaired. Optional on purpose: a
// renamed slot should leave a reserved slot behind, not fail the build.
const irPhoto = gallery.find((g) => g.slot === 'project-siding-crew');
const irSrc = irPhoto ? optionalImage(`img/${irPhoto.slot}`) : undefined;

/* A photograph beside each group, the same pairing the homepage uses for
   its service cards so the two pages agree. The company's own photographs;
   decorative here, so alt is empty. A group without one simply has none. */
const groupPhotoSlots: Record<string, { slot: string; pos: string }> = {
  remodeling: { slot: 'project-kitchen-blue-island-wide', pos: '50% 62%' },
  'interior-exterior': { slot: 'project-stairs-hardwood', pos: '50% 55%' },
  restoration: { slot: 'project-soffit-insulation', pos: '50% 30%' },
  permits: { slot: 'project-framing-joists', pos: '50% 45%' },
};
const groupPhoto = (id: string) => {
  const p = groupPhotoSlots[id];
  const src = p ? optionalImage(`img/${p.slot}`) : undefined;
  return src ? { src, pos: p.pos } : undefined;
};
---

<Page
  title="Services — Interior Design Flooring"
  description="Remodeling, additions, kitchens, bathrooms, basements, flooring, restoration, permits, and inspections in Northern Virginia."
  heading="Services"
  standfirst="One licensed contractor for the whole job, including the paperwork."
  current="/services/"
  image={pageImages.services}
>
  <section class="hp-section hp-section--tight">
    <div class="sv-list">
      {
        serviceGroups.map((g) => (
          <article class:list={['sv-group', { 'sv-group--photo': groupPhoto(g.id) }]} id={g.id}>
            {groupPhoto(g.id) && (
              <img
                class="sv-photo"
                src={groupPhoto(g.id)!.src}
                style={`object-position: ${groupPhoto(g.id)!.pos}`}
                alt=""
                loading="lazy"
                decoding="async"
              />
            )}
            <h2 class="sv-title">{g.title}</h2>
            <ul class="sv-items">
              {g.items.map((i) => (
                <li>{itemHref(i) ? <a class="sv-item-link" href={itemHref(i)}>{i}</a> : i}</li>
              ))}
            </ul>
            <a class="hp-pillar-link" href="/estimate/">Start an estimate</a>
          </article>
        ))
      }
    </div>
  </section>

  {/* All twelve detail pages, as the same picture cards each service page ends
      with, so the hub is a way in rather than a dead end. */}
  <section class="hp-section hp-section--tight svc-more" aria-labelledby="sv-all-h">
    <h2 class="hp-h2" id="sv-all-h">Every service in detail</h2>
    <ul class="svc-cards">
      {servicePages.map((s) => (
        <li>
          <a class="svc-card" href={`/services/${s.slug}/`}>
            <span class="svc-card-media">
              <img
                src={serviceImageSet(s.slug).card}
                alt=""
                width="640"
                height="427"
                loading="lazy"
                decoding="async"
              />
            </span>
            <span class="svc-card-label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="hp-section hp-section--tight ir-section" id="insurance-restoration">
    <h2 class="hp-h2">{insuranceRestoration.title}</h2>
    <p class="hp-sub hp-italic">{insuranceRestoration.standfirst}</p>

    <div class="ir-lede">
      <div class="ir-intro">
        {insuranceRestoration.intro.map((para) => <p>{para}</p>)}
      </div>
      <figure class="ir-figure">
        <Placeholder
          ratio="4 / 3"
          label="Reserved — exterior repair underway"
          src={irSrc}
          alt={irPhoto?.alt ?? ''}
          real
          class="gal-ph"
        />
        {irPhoto && <figcaption class="gal-cap-detail">{irPhoto.detail}</figcaption>}
      </figure>
    </div>

    <ol class="ir-items">
      {
        insuranceRestoration.items.map((item, i) => (
          <li class="ir-item">
            <span class="ir-num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="ir-item-title">{item.title}</h3>
            <p class="ir-item-detail">{item.detail}</p>
          </li>
        ))
      }
    </ol>

    <aside class="ir-limit">
      <h3 class="ir-limit-title">{insuranceRestoration.limit.title}</h3>
      <p>{insuranceRestoration.limit.body}</p>
    </aside>

    <a class="hp-textlink" href="/estimate/">Request an estimate for damage repair</a>
  </section>

  <section class="hp-final">
    <div class="hp-final-inner hp-final-inner--single">
      <div>
        <h2 class="hp-final-heading">Not sure which one you need?</h2>
        <p class="hp-final-sub hp-italic">Describe the work and we will tell you straight.</p>
        <div class="hp-hero-actions">
          <a class="hp-btn" href="/estimate/">{cta.primary}</a>
          <a class="hp-call hp-call--light" href={business.phonePrimaryHref}>
            or call {business.phonePrimary}
          </a>
        </div>
      </div>
    </div>
  </section>
</Page>

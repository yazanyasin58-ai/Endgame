---
/**
 * Variant C — Panelled
 * Structured cards on cream. Newsreader over IBM Plex Sans, bordered
 * panels with soft shadow, the process drawn as a connected timeline.
 * The most product-like and the easiest to scan.
 *
 * Shares HomeSections with the other variants; only the stylesheet and the
 * type pairing differ, so content cannot drift between them.
 */
import Base from '../layouts/Base.astro';
import '../styles/home.css';
import '../styles/variant-c.css';
import SiteNav from '../components/SiteNav.astro';
import PromoBar from '../components/PromoBar.astro';
import HomeSections from '../components/HomeSections.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StickyCallBar from '../components/StickyCallBar.astro';
import VariantSwitcher from '../components/VariantSwitcher.astro';

const fonts = 'https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;1,6..72,300&family=IBM+Plex+Sans:wght@400;500;600&display=swap';
---

<Base
  title="Interior Design Flooring — Custom Homes, Additions & Remodeling in Northern Virginia"
  description="Virginia Class A general contractor, owner-run since 1989. Custom homes, additions and remodeling in Northern Virginia. Written estimate within 24 hours of the site visit."
  fontsHref={fonts}
  bodyClass="hp vc"
  withCallbar
>
  <VariantSwitcher current="c" />
  <PromoBar />
  <SiteNav current="home" />
  <HomeSections />
  <SiteFooter />
  <StickyCallBar />
</Base>

---
import Base from '../layouts/Base.astro';
import { business, versions } from '../content/idf';

const fonts =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,300;9..144,400&family=Public+Sans:wght@400;500;600&display=swap';
---

<Base
  title="Interior Design Flooring — Homepage Design Directions"
  description="Five homepage design directions for Interior Design Flooring, Sterling VA — internal design review index."
  fontsHref={fonts}
  bodyClass="idx"
>
  <main class="mx-auto max-w-3xl px-6 py-16 md:py-24">
    <p class="idx-eyebrow">Design review — homepage only, phase one</p>
    <h1 class="idx-title">{business.name}</h1>
    <p class="idx-sub">
      {business.lockup} · Sterling, Virginia · Five homepage directions, one approved content
      skeleton. Same nine sections in each — only the treatment changes.
    </p>

    <a class="idx-chosen" href="/home/">
      <span class="idx-chosen-tag">Chosen direction</span>
      <span class="idx-chosen-name">Homepage — warm light editorial</span>
      <span class="idx-chosen-blurb">
        V4's light system carrying V1's monumental hero. Verified figures, why one team,
        selected projects, how it works, price your project.
      </span>
    </a>
    <a class="idx-chosen idx-chosen--alt" href="/estimate/">
      <span class="idx-chosen-tag">Page</span>
      <span class="idx-chosen-name">Request an estimate</span>
      <span class="idx-chosen-blurb">The primary CTA target, on its own page.</span>
    </a>

    <p class="idx-eyebrow idx-eyebrow--spaced">The five original directions</p>
    <ol class="idx-list">
      {
        versions.map((v) => (
          <li>
            <a class="idx-card" href={v.path}>
              <span class="idx-num">{v.id.toUpperCase()}</span>
              <span class="idx-body">
                <span class="idx-name">{v.label}</span>
                <span class="idx-blurb">{v.blurb}</span>
              </span>
              <span class="idx-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="idx-note">
      All imagery slots are labelled CSS placeholders — real project photography arrives in a later
      phase. Hours and the service-area list are blocked pending client confirmation and are marked
      as such on every version.
    </p>
  </main>
</Base>

<style is:global>
  .idx {
    background: var(--ink);
    color: var(--cream);
    font-family: 'Public Sans', sans-serif;
  }
  .idx-eyebrow {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-bright);
    margin-bottom: 1.5rem;
  }
  .idx-title {
    font-family: 'Fraunces', serif;
    font-weight: 300;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }
  .idx-sub {
    color: var(--stone);
    max-width: 46ch;
    margin-top: 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .idx-chosen {
    display: block;
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--gold);
    background: rgb(200 162 74 / 0.07);
    text-decoration: none;
    color: inherit;
  }
  .idx-chosen:hover { background: rgb(200 162 74 / 0.14); }
  .idx-chosen--alt { margin-top: 0.75rem; border-color: rgb(246 241 231 / 0.25); background: none; }
  .idx-chosen-tag {
    display: block;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-bright);
  }
  .idx-chosen-name {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 1.6rem;
    margin-top: 0.4rem;
  }
  .idx-chosen-blurb {
    display: block;
    color: var(--stone);
    font-size: 0.8125rem;
    line-height: 1.6;
    margin-top: 0.4rem;
    max-width: 56ch;
  }
  .idx-eyebrow--spaced { margin-top: 3rem; margin-bottom: 0 !important; }
  .idx-list {
    margin-top: 3.5rem;
    display: grid;
    gap: 1px;
    background: rgb(246 241 231 / 0.16);
    border-block: 1px solid rgb(246 241 231 / 0.16);
  }
  .idx-card {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.5rem 0.5rem;
    background: var(--ink);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .idx-card:hover {
    background: var(--charcoal);
  }
  .idx-num {
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.75rem;
    color: var(--gold-bright);
    flex: none;
    width: 2.25rem;
  }
  .idx-body {
    display: block;
    flex: 1;
  }
  .idx-name {
    display: block;
    font-family: 'Fraunces', serif;
    font-size: 1.5rem;
    font-weight: 400;
  }
  .idx-blurb {
    display: block;
    color: var(--stone);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin-top: 0.35rem;
    max-width: 52ch;
  }
  .idx-arrow {
    color: var(--gold);
  }
  .idx-note {
    margin-top: 3rem;
    font-family: ui-monospace, Menlo, monospace;
    font-size: 0.6875rem;
    line-height: 1.7;
    letter-spacing: 0.04em;
    color: var(--stone);
    border: 1px dashed rgb(169 162 150 / 0.5);
    padding: 1rem 1.25rem;
  }
</style>

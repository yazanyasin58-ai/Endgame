---
/**
 * Real estate — the generic version.
 *
 * This page used to advertise brokerage services under the Interior Design
 * Flooring name and was gated behind features.realEstate for that reason:
 * Virginia requires the entity advertising those services to hold a real
 * estate FIRM license and to name it, and the agent's license hangs under
 * Samson Companies LLC, a different company.
 *
 * On the owner's instruction of 5 Sep the page now offers what this company is
 * actually licensed to do — renovation work that gets a house ready to sell —
 * and offers an introduction to a licensed agent rather than the listing
 * itself. A referral is not brokerage, so no firm license is required and the
 * gate no longer applies.
 *
 * On the client's request of 13 Oct it also covers buying, renting out,
 * looking to rent and managing a rental, as `propertyPaths`: each one the
 * work this company does plus a hand-off to a licensed professional, never
 * the transaction itself. The rules are in the note above `propertyPaths`.
 *
 * If the brokerage copy ever comes back, so must the gate. The three things
 * that must not return without the firm license number are listed above
 * `realEstate` in content/idf.ts.
 */
import Page from '../layouts/Page.astro';
import { business, propertyPaths, realEstate, realEstateLicense, serviceArea } from '../content/idf';

const agent = realEstateLicense.agent;
---

<Page
  title="Real estate — Interior Design Flooring"
  description="Buying, selling, renting out or managing a property in Northern Virginia? The work it needs and what that costs, from a Class A contractor, and an introduction to a licensed agent for the rest."
  heading="Real estate"
  standfirst={realEstate.standfirst}
  current="/real-estate/"
>
  <section class="hp-section" aria-labelledby="re-paths-h">
    <h2 id="re-paths-h" class="hp-h2">Whatever you are doing with a property</h2>
    <div class="re-grid re-paths">
      {
        propertyPaths.map((path) => (
          <div class="re-item" id={path.key}>
            <h3>{path.title}</h3>
            {'kinds' in path && <p class="re-kinds">{path.kinds}</p>}
            <p>{path.detail}</p>
            <p class="re-handoff">{path.handoff}</p>
            <a class="re-path-link" href={`/list-your-home/?for=${path.key}#listing-form`}>
              Tell us about it<span class="hp-visually-hidden">: {path.title.toLowerCase()}</span>
            </a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="hp-section hp-section--tight re-prose" aria-labelledby="re-sell-h">
    <h2 id="re-sell-h" class="hp-h2">Selling a home</h2>
    {realEstate.intro.map((para) => <p class="hp-lede">{para}</p>)}
  </section>

  <section class="hp-section" aria-labelledby="re-points-h">
    <h2 id="re-points-h" class="hp-h2">How we help a sale</h2>
    <div class="re-grid">
      {
        realEstate.points.map((point) => (
          <div class="re-item">
            <h3>{point.title}</h3>
            <p>{point.detail}</p>
            {'agent' in point && point.agent && (
              <p class="re-credential">
                <span class="re-credential-name">{agent.name}</span>
                <span class="re-credential-line">{agent.title}</span>
                <span class="re-credential-line">Virginia license {agent.licenseNumber}</span>
                <span class="re-credential-line">{realEstateLicense.firmName}</span>
              </p>
            )}
          </div>
        ))
      }
    </div>
  </section>

  <section class="hp-section hp-section--tight re-prose" aria-labelledby="re-cta-h">
    <h2 id="re-cta-h" class="hp-h2">Talk to us</h2>
    <p class="hp-lede">{realEstate.cta}</p>
    <p class="re-actions">
      <a class="hp-call" href={business.phonePrimaryHref}>Call {business.phonePrimary}</a>
      <a class="hp-textlink" href="/list-your-home/">Or tell us about the property</a>
    </p>
    <p class="re-note">
      Interior Design Flooring is a {business.license}. We are contractors, not a real
      estate brokerage or a property manager. Buying, selling, leasing and managing
      property are handled by licensed professionals, and we are glad to introduce you
      to a licensed agent. {agent.name} is licensed with {realEstateLicense.firmName},
      a separate company from Interior Design Flooring. Serving {serviceArea.short}.
    </p>
  </section>
</Page>

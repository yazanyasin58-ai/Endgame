---
/**
 * Real estate.
 *
 * Gated on features.realEstate, which has three states — see the gate
 * definition in content/idf.ts. In 'preview' the full page renders so the
 * owner can read and approve the copy, carrying a notice that says it is not
 * cleared, staying out of the nav and out of search. Only `true` publishes it,
 * and `true` requires the Virginia real estate FIRM licence number in
 * `realEstateLicence`.
 *
 * The gate is not decoration. Virginia requires real estate advertising to
 * carry the licensed firm's name; individual agents licensed under some other
 * brokerage does not satisfy it. Publishing without that is the kind of thing
 * that costs a licence, not a redesign.
 */
import Page from '../layouts/Page.astro';
import BlockedSlot from '../components/BlockedSlot.astro';
import { business, features, realEstate, realEstateLicence, serviceArea } from '../content/idf';

const preview = features.realEstate === 'preview';
const live = features.realEstate === true;
const licensed = realEstateLicence.firmName !== '' && realEstateLicence.licenceNumber !== '';
---

<Page
  title="Real Estate — Interior Design Flooring"
  description="In-house realtors for sales, rentals, land and investment property across DC, Maryland and Virginia — with the renovation team under the same roof."
  heading="Real estate"
  standfirst={live || preview ? realEstate.standfirst : 'This page is not cleared for publication.'}
  current="/real-estate/"
  noindex={!live}
>
  {
    live || preview ? (
      <>
        <section class="hp-section hp-section--tight re-prose">
          {preview && (
            <div class="pv-notice">
              <p><strong>Preview — not published.</strong> This page is here for you to read
              and approve. It is left out of the site menu and out of search engines, and
              nobody reaches it without this link.</p>
              <p>
                Everything on this page is written and ready — the services, the 10% credit,
                Sameer and Ali with their licence numbers. <strong>One thing is missing:
                the name of the brokerage they currently hold those licences under.</strong>
              </p>
              <p>
                Those numbers are salesperson licences, which are held under a firm. Virginia
                requires the firm's name in real estate advertising so the public can see
                which brokerage stands behind it — naming the agents alone is the exact thing
                that rule prevents, and the risk sits on their licences rather than on the
                website. If the brokerage changes often, that is a reason to put it in and
                update it, not to leave it out: it is one line, and it takes a minute.
              </p>
            </div>
          )}
          {realEstate.intro.map((para) => <p class="hp-lede">{para}</p>)}
        </section>

        <section class="hp-section" aria-labelledby="re-services-h">
          <h2 id="re-services-h" class="hp-h2">What our realtors handle</h2>
          <div class="re-grid">
            {realEstate.services.map((s) => (
              <article class="re-item">
                <h3>{s.title}</h3>
                <p>{s.detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="hp-section" aria-labelledby="re-team-h">
          <h2 id="re-team-h" class="hp-h2">Our in-house realtors</h2>
          <div class="re-grid">
            {realEstate.realtors.map((r) => (
              <article class="re-item">
                <h3>{r.name}</h3>
                <p>Virginia real estate licence {r.licence}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="hp-section" aria-labelledby="re-offer-h">
          <div class="re-offer">
            <h2 id="re-offer-h" class="hp-h2">{realEstate.discount.title}</h2>
            {realEstate.discount.body.map((para) => <p>{para}</p>)}
            <a class="hp-btn" href="/list-your-home/">List My Home</a>
          </div>
        </section>

        <section class="hp-section hp-section--tight re-prose">
          <p class="hp-lede">
            Buying, selling, renting, building or renovating — it is one call either way.
            Reach us on <a href={business.phonePrimaryHref}>{business.phonePrimary}</a>.
          </p>
          <p class="re-licence">
            {serviceArea.detail}
            {licensed && (
              <>
                {' '}Real estate services offered by {realEstateLicence.firmName}, Virginia
                real estate firm licence {realEstateLicence.licenceNumber}.
              </>
            )}
          </p>
        </section>
      </>
    ) : (
      <section class="hp-section hp-section--tight">
        <div class="fin-blocked">
          <BlockedSlot label="REAL ESTATE SERVICES — BLOCKED PENDING FIRM LICENCE VERIFICATION" />
          <p class="fin-blocked-note">
            Advertising brokerage services in Virginia requires the advertising entity to
            hold a real estate <strong>firm</strong> licence. Individual agents holding
            licences under another brokerage is not sufficient, and advertisements must
            carry the licensed brokerage name.
          </p>
        </div>
      </section>
    )
  }
</Page>
